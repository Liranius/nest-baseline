  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Login": {
        "type": "object",
        "properties": {
          "login": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "writeOnly": true
          }
        },
        "required": ["login", "password"],
        "additionalProperties": false
      },
      "Token": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "tokenType": {
            "const": "Bearer"
          },
          "expiresIn": {
            "const": 900
          }
        },
        "required": ["accessToken", "tokenType", "expiresIn"],
        "additionalProperties": false
      },
      "Identity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "login": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["employee", "admin"]
          },
          "organizationId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": ["id", "login", "role", "organizationId"],
        "additionalProperties": false
      },
      "Equipment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      },
      "Interval": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["from", "to"],
        "additionalProperties": false
      },
      "BookingRequest": {
        "type": "object",
        "properties": {
          "equipmentId": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          },
          "to": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?(Z|[+-][0-9]{2}:[0-9]{2})$"
          }
        },
        "required": ["equipmentId", "from", "to"],
        "additionalProperties": false
      },
      "Receipt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "Reservation": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "equipmentId": {
            "type": "string",
            "format": "uuid"
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "enum": ["confirmed", "cancelled"]
          }
        },
        "required": ["id", "equipmentId", "from", "to", "status"],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "enum": [
              "INVALID_INPUT",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "SLOT_CONFLICT",
              "IDEMPOTENCY_KEY_REUSED",
              "RESERVATION_CANCELLED",
              "OUTSIDE_PICKUP_WINDOW",
              "EQUIPMENT_IN_USE",
              "NOT_CHECKED_OUT",
              "HANDOVER_EXISTS"
            ]
          },
          "message": {
            "type": "string"
          }
        },
        "required": ["code", "message"],
        "additionalProperties": false
      },
      "HandoverReceipt": {
        "type": "object",
        "properties": {
          "handoverId": {
            "type": "string",
            "format": "uuid"
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": ["handoverId", "actorId", "at"],
        "additionalProperties": false
      },
      "Handover": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "format": "uuid"
          },
          "equipmentId": {
            "type": "string",
            "format": "uuid"
          },
          "reservationStatus": {
            "enum": ["confirmed", "cancelled"]
          },
          "state": {
            "enum": ["pending", "cancelled", "checked_out", "returned"]
          },
          "checkout": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HandoverReceipt"
              },
              {
                "type": "null"
              }
            ]
          },
          "returned": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HandoverReceipt"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "reservationId",
          "equipmentId",
          "reservationStatus",
          "state",
          "checkout",
          "returned"
        ],
        "additionalProperties": false
      },
      "ReservationEvent": {
        "type": "object",
        "properties": {
          "action": {
            "enum": ["created", "cancelled", "checked_out", "returned"]
          },
          "actorId": {
            "type": "string",
            "format": "uuid"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "from": {
            "anyOf": [
              {
                "enum": ["confirmed", "cancelled", "checked_out", "returned"]
              },
              {
                "type": "null"
              }
            ]
          },
          "to": {
            "enum": ["confirmed", "cancelled", "checked_out", "returned"]
          }
        },
        "required": ["action", "actorId", "at", "from", "to"],
        "additionalProperties": false
      },
      "ReservationAudit": {
        "type": "object",
        "properties": {
          "reservationId": {
            "type": "string",
            "format": "uuid"
          },
          "equipmentId": {
            "type": "string",
            "format": "uuid"
          },
          "reservationStatus": {
            "enum": ["confirmed", "cancelled"]
          },
          "coverage": {
            "enum": ["complete", "from_migration"],
            "description": "from_migration means pre-upgrade changes have no recorded event."
          },
          "events": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReservationEvent"
            }
          }
        },
        "required": ["reservationId", "equipmentId", "reservationStatus", "coverage", "events"],
        "additionalProperties": false
      }
    }
  }
}
