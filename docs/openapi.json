                        "code": {
                          "enum": ["FORBIDDEN"]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "404": {
            "description": "NOT_FOUND",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "code": {
                          "enum": ["NOT_FOUND"]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "409": {
            "description": "NOT_CHECKED_OUT",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
