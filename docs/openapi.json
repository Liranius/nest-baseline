    "/v1/reservations/{id}/handover": {
      "get": {
        "operationId": "getHandover",
        "description": "An employee may see only their own progress. A lab administrator may look up any reservation by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
