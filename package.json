{
  "name": "nest-baseline",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.22.2 <25",
    "pnpm": "12.4.2"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.22.2 <25",
      "onFail": "error"
    }
  },
  "scripts": {
    "build": "nest build",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run test:e2e && pnpm run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks:install": "lefthook install",
    "knowledge:setup": "node scripts/knowledge.mjs setup",
    "knowledge:doctor": "node scripts/knowledge.mjs doctor",
    "knowledge:cli": "node scripts/knowledge.mjs cli",
    "knowledge:check": "node scripts/knowledge-review.mjs check",
    "knowledge:find": "node scripts/knowledge-review.mjs find",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/ scripts/ vitest.config.ts vitest.config.e2e.ts",
    "typecheck": "tsc --project tsconfig.json --noEmit --incremental false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "js-yaml": "4.3.2",
    "lefthook": "2.1.14",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
